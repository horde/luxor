// ----------------------------------------------------------------------
// Paths
// ----------------------------------------------------------------------
// Location of Exuberant Ctags executable (ctags.sourceforge.net)
$conf['paths']['ectags'] = '/usr/bin/ctags';

// ----------------------------------------------------------------------
// Look and feel
// ----------------------------------------------------------------------
// Does your web server support mod_rewrite? If so, we can generate "pretty" URLs. If not, pathnames will be propagated ... ('get' = GET (will always work), 'rewrite' = mod_rewrite (pretty, short URLs))
$conf['options']['urls'] = 'get';
// Should we enable highlighting of variables in source listings?
$conf['options']['use_show_var'] = true;
